                        "gencode": "Delay ydel(96000);\nParam g(0.773);\nParam fbx(0);\nDelay ydel_1(96000);\nParam h(0.802);\nDelay ydel_2(96000);\nParam j(0.753);\nDelay ydel_3(96000);\nParam k(0.733);\nHistory history_4(0);\nds = ((39.0702948 * samplerate)) * 0.001;\nds_5 = clamp(ds, 1, 90000);\ny_d = ydel.read(ds_5);\ny = ((in1 + (g * y_d))) + (fbx * history_4);\nydel.write(y);\nexpr_6 = y;\nout1 = expr_6;\nds_7 = ((35.3514739 * samplerate)) * 0.001;\nds_8 = clamp(ds_7, 1, 90000);\ny_d_9 = ydel_1.read(ds_8);\ny_10 = ((in1 + (h * y_d_9))) + (fbx * expr_6);\nydel_1.write(y_10);\nexpr_11 = y_10;\nds_12 = ((49.0022676 * samplerate)) * 0.001;\nds_13 = clamp(ds_12, 1, 90000);\ny_d_14 = ydel_2.read(ds_13);\ny_15 = ((in1 + (j * y_d_14))) + (fbx * expr_11);\nydel_2.write(y_15);\nexpr_16 = y_15;\nout3 = expr_16;\nds_17 = ((52.4036281 * samplerate)) * 0.001;\nds_18 = clamp(ds_17, 1, 90000);\ny_d_19 = ydel_3.read(ds_18);\ny_20 = ((in1 + (k * y_d_19))) + (fbx * expr_16);\nydel_3.write(y_20);\nexpr_21 = y_20;\nout4 = expr_21;\nout2 = expr_11;\nhistory_4_next_22 = fixdenorm(expr_21);\nhistory_4 = history_4_next_22;",

            {
                "box": {
                    "code": "// Schroeder Mixing Matrix\r\n// Inputs: in1, in2, in3, in4  (from 4 FBCFs)\r\n// Outputs: out1 = Left, out2 = Right\r\n\r\nx1 = in1;\r\nx2 = in2;\r\nx3 = in3;\r\nx4 = in4;\r\n\r\n// intermediate sums\r\ns1 = x1 + x3;\r\ns2 = x2 + x4;\r\n\r\n// stereo outputs (OutA / OutD)\r\nout1 = (s1 + s2) * 0.25;   // Left\r\nout2 = (s1 - s2) * in5;   // Right\r\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-10",
                    "maxclass": "codebox~",

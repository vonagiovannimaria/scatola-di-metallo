                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 1558.0, 91.0, 349.0, 421.0 ],
                                        "fontsize": 12.0,
                                        "numinlets": 2,
                                        "fontname": "<Monospaced>",
                                        "numoutlets": 1,
                                        "fontface": 0,
                                        "outlettype": [ "" ],
                                        "id": "obj-7",
                                        "code": "// delay line (size independent from SR)\r\nDelay ydel(96000);\r\n\r\n// ===== Parameters (exposed) =====\r\nParam k(0.733);      // INTERNAL feedback (decay)\r\nParam fbx(0.0);      // INTER-FBCF feedback (0 = V1 behavior)\r\n\r\n// ===== Internal constants =====\r\nd_ms      = 53.0385488;   // 2339 samples @ 44.1kHz\r\noffset_ms = 0;\r\n\r\n// ===== Delay in samples =====\r\nds = (d_ms + offset_ms) * samplerate * 0.001;\r\nds = clamp(ds, 1, 90000);\r\n\r\n// ===== Read delay =====\r\ny_d = ydel.read(ds);\r\n\r\n// ===== Comb equation =====\r\n// in1 = direct signal\r\n// in2 = feedback from other FBCFs (same bank)\r\ny = in1\r\n  + (k * y_d)\r\n  + (fbx * in2);\r\n\r\n// ===== Write feedback =====\r\nydel.write(y);\r\n\r\n// ===== Output =====\r\nout1 = y;"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 1101.0, 91.0, 447.0, 421.0 ],
                                        "fontsize": 12.0,
                                        "numinlets": 2,
                                        "fontname": "<Monospaced>",
                                        "numoutlets": 1,
                                        "fontface": 0,
                                        "outlettype": [ "" ],
                                        "id": "obj-8",
                                        "code": "// delay line (size independent from SR)\r\nDelay ydel(96000);\r\n\r\n// ===== Parameters (exposed) =====\r\nParam j(0.753);      // INTERNAL feedback (decay)\r\nParam fbx(0.0);      // INTER-FBCF feedback (0 = V1 behavior)\r\n\r\n// ===== Internal constants =====\r\nd_ms      = 48.5487528;   // 2141 samples @ 44.1kHz\r\noffset_ms = 0;\r\n\r\n// ===== Delay in samples =====\r\nds = (d_ms + offset_ms) * samplerate * 0.001;\r\nds = clamp(ds, 1, 90000);\r\n\r\n// ===== Read delay =====\r\ny_d = ydel.read(ds);\r\n\r\n// ===== Comb equation =====\r\n// in1 = direct signal\r\n// in2 = feedback from other FBCFs (same bank)\r\ny = in1\r\n  + (j * y_d)\r\n  + (fbx * in2);\r\n\r\n// ===== Write feedback =====\r\nydel.write(y);\r\n\r\n// ===== Output =====\r\nout1 = y;"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 570.0, 91.0, 520.0, 421.0 ],
                                        "fontsize": 12.0,
                                        "numinlets": 2,
                                        "fontname": "<Monospaced>",
                                        "numoutlets": 1,
                                        "fontface": 0,
                                        "outlettype": [ "" ],
                                        "id": "obj-6",
                                        "code": "// delay line (size independent from SR)\r\nDelay ydel(96000);\r\n\r\n// ===== Parameters (exposed) =====\r\nParam h(0.802);      // INTERNAL feedback (decay)\r\nParam fbx(0.0);      // INTER-FBCF feedback (0 = V1 behavior)\r\n\r\n// ===== Internal constants =====\r\nd_ms      = 34.5351474;   // 1523 samples @ 44.1kHz\r\noffset_ms = 0;\r\n\r\n// ===== Delay in samples =====\r\nds = (d_ms + offset_ms) * samplerate * 0.001;\r\nds = clamp(ds, 1, 90000);\r\n\r\n// ===== Read delay =====\r\ny_d = ydel.read(ds);\r\n\r\n// ===== Comb equation =====\r\n// in1 = direct signal\r\n// in2 = feedback from other FBCFs (same bank)\r\ny = in1\r\n  + (h * y_d)\r\n  + (fbx * in2);\r\n\r\n// ===== Write feedback =====\r\nydel.write(y);\r\n\r\n// ===== Output =====\r\nout1 = y;"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 50.0, 91.0, 512.0, 483.0 ],
                                        "fontsize": 12.0,
                                        "numinlets": 2,
                                        "fontname": "<Monospaced>",
                                        "numoutlets": 1,
                                        "fontface": 0,
                                        "outlettype": [ "" ],
                                        "id": "obj-5",
                                        "code": "// =====================================\r\n// Feedback Comb Filter (FBCF)\r\n// with inter-FBCF feedback\r\n// =====================================\r\n\r\n// delay line (size independent from SR)\r\nDelay ydel(96000);\r\n\r\n// ===== Parameters (exposed) =====\r\nParam g(0.773);      // INTERNAL feedback (decay)\r\nParam fbx(0.0);      // INTER-FBCF feedback (0 = V1 behavior)\r\n\r\n// ===== Internal constants =====\r\nd_ms      = 39.478458;   // 1741 samples @ 44.1kHz\r\noffset_ms = 0;\r\n\r\n// ===== Delay in samples =====\r\nds = (d_ms + offset_ms) * samplerate * 0.001;\r\nds = clamp(ds, 1, 90000);\r\n\r\n// ===== Read delay =====\r\ny_d = ydel.read(ds);\r\n\r\n// ===== Comb equation =====\r\n// in1 = direct signal\r\n// in2 = feedback from other FBCFs (same bank)\r\ny = in1\r\n  + (g * y_d)\r\n  + (fbx * in2);\r\n\r\n// ===== Write feedback =====\r\nydel.write(y);\r\n\r\n// ===== Output =====\r\nout1 = y;\r\n"
                                    }
                                },

            {
                "box": {
                    "genpatcher": {
                        "patcher": {
                            "fileversion": 1,
                            "appversion": {
                                "major": 9,
                                "minor": 1,
                                "revision": 2,
                                "architecture": "x64",
                                "modernui": 1
                            },
                            "classnamespace": "dsp.gen",
                            "rect": [ 34.0, 77.0, 1980.0, 993.0 ],
                            "boxes": [
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 358.0, 55.0, 824.0, 792.0 ],
                                        "fontsize": 12.0,
                                        "numinlets": 1,
                                        "fontname": "<Monospaced>",
                                        "numoutlets": 1,
                                        "fontface": 0,
                                        "outlettype": [ "" ],
                                        "id": "obj-5",
                                        "code": "// ===============================\r\n// EARLY IR – ROOM (FIR)\r\n// ===============================\r\n\r\n// delay buffers\r\nDelay d1(6000);  Delay d2(6000);  Delay d3(6000);  Delay d4(6000);\r\nDelay d5(6000);  Delay d6(6000);  Delay d7(6000);  Delay d8(6000);\r\nDelay d9(6000);  Delay d10(6000); Delay d11(6000); Delay d12(6000);\r\nDelay d13(6000); Delay d14(6000); Delay d15(6000); Delay d16(6000);\r\nDelay d17(6000); Delay d18(6000); Delay d19(6000); Delay d20(6000);\r\nDelay d21(6000); Delay d22(6000); Delay d23(6000); Delay d24(6000);\r\n\r\n// FIR sum (natural spacing)\r\ny =\r\n    d1.read(  53) * 0.32 +\r\n    d2.read(  79) * 0.30 +\r\n    d3.read( 121) * 0.28 +\r\n    d4.read( 167) * 0.26 +\r\n\r\n    d5.read( 233) * 0.24 +\r\n    d6.read( 317) * 0.22 +\r\n    d7.read( 401) * 0.20 +\r\n    d8.read( 487) * 0.18 +\r\n\r\n    d9.read( 593) * 0.16 +\r\n    d10.read(719) * 0.15 +\r\n    d11.read(857) * 0.14 +\r\n    d12.read(1013)* 0.13 +\r\n\r\n    d13.read(1187)* 0.12 +\r\n    d14.read(1373)* 0.11 +\r\n    d15.read(1579)* 0.10 +\r\n    d16.read(1801)* 0.09 +\r\n\r\n    d17.read(2053)* 0.08 +\r\n    d18.read(2321)* 0.07 +\r\n    d19.read(2617)* 0.06 +\r\n    d20.read(2953)* 0.055 +\r\n\r\n    d21.read(3317)* 0.050 +\r\n    d22.read(3719)* 0.045 +\r\n    d23.read(4159)* 0.040 +\r\n    d24.read(4639)* 0.035;\r\n\r\n// write input\r\nd1.write(in1);  d2.write(in1);  d3.write(in1);  d4.write(in1);\r\nd5.write(in1);  d6.write(in1);  d7.write(in1);  d8.write(in1);\r\nd9.write(in1);  d10.write(in1); d11.write(in1); d12.write(in1);\r\nd13.write(in1); d14.write(in1); d15.write(in1); d16.write(in1);\r\nd17.write(in1); d18.write(in1); d19.write(in1); d20.write(in1);\r\nd21.write(in1); d22.write(in1); d23.write(in1); d24.write(in1);\r\n\r\n// output\r\nout1 = y;\r\n"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "in 1",
                                        "patching_rect": [ 50.0, 14.0, 28.0, 22.0 ],

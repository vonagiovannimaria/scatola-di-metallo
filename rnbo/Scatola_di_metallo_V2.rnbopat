                            "classnamespace": "dsp.gen",
                            "rect": [ 134.0, 134.0, 1468.0, 705.0 ],
                            "boxes": [
                                {
                                    "box": {
                                        "maxclass": "newobj",
                                        "text": "history",
                                        "patching_rect": [ 531.0, 88.0, 44.0, 22.0 ],
                                        "numinlets": 1,
                                        "numoutlets": 1,

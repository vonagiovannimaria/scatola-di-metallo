            {
                "box": {
                    "genpatcher": {
                        "patcher": {
                            "fileversion": 1,
                            "appversion": {
                                "major": 9,
                                "minor": 1,
                                "revision": 2,
                                "architecture": "x64",
                                "modernui": 1
                            },
                            "classnamespace": "dsp.gen",
                            "rect": [ 34.0, 77.0, 1980.0, 993.0 ],
                            "boxes": [
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 519.0, 560.0, 340.0, 200.0 ],
                                        "fontsize": 12.0,
                                        "numinlets": 1,
                                        "fontname": "<Monospaced>",
                                        "numoutlets": 1,
                                        "fontface": 0,
                                        "outlettype": [ "" ],
                                        "id": "obj-7",
                                        "code": "Delay xdel(44100);\r\nDelay ydel(44100);\r\n\r\nParam mult(1.0);\r\n\r\ng      = 0.7;   // diffusion coefficient (FIXED)\r\nd_base = 37;   // base delay (samples)\r\noffset = 0;\r\n\r\nds = d_base * mult + offset;\r\nds = max(1, min(4000, ds));   // safety clamp\r\n\r\nx_d = xdel.read(ds);\r\ny_d = ydel.read(ds);\r\n\r\n// allpass equation\r\ny = (-g * in1) + x_d + (g * y_d);\r\n\r\nxdel.write(in1);\r\nydel.write(y);\r\n\r\nout1 = y;\r\n"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 239.0, 335.0, 340.0, 200.0 ],
                                        "fontsize": 12.0,
                                        "numinlets": 1,
                                        "fontname": "<Monospaced>",
                                        "numoutlets": 1,
                                        "fontface": 0,
                                        "outlettype": [ "" ],
                                        "id": "obj-6",
                                        "code": "Delay xdel(44100);\r\nDelay ydel(44100);\r\n\r\nParam mult(1.0);\r\n\r\ng      = 0.7;   // diffusion coefficient (FIXED)\r\nd_base = 113;   // base delay (samples)\r\noffset = 0;\r\n\r\nds = d_base * mult + offset;\r\nds = max(1, min(4000, ds));   // safety clamp\r\n\r\nx_d = xdel.read(ds);\r\ny_d = ydel.read(ds);\r\n\r\n// allpass equation\r\ny = (-g * in1) + x_d + (g * y_d);\r\n\r\nxdel.write(in1);\r\nydel.write(y);\r\n\r\nout1 = y;\r\n"
                                    }
                                },
                                {
                                    "box": {
                                        "maxclass": "codebox",
                                        "patching_rect": [ 28.0, 104.0, 340.0, 200.0 ],
                                        "fontsize": 12.0,
                                        "numinlets": 1,
                                        "fontname": "<Monospaced>",
                                        "numoutlets": 1,
                                        "fontface": 0,
                                        "outlettype": [ "" ],
                                        "id": "obj-5",
                                        "code": "// APF\r\n\r\nDelay xdel(44100);\r\nDelay ydel(44100);\r\n\r\nParam mult(1.0);  \r\n\r\ng      = 0.7;\r\nd_base = 347;\r\noffset = 0;\r\n\r\nds = d_base * mult + offset;\r\nds = max(1, min(4000, ds));\r\n\r\nx_d = xdel.read(ds);\r\ny_d = ydel.read(ds);\r\n\r\ny = (-g * in1) + x_d + (g * y_d);\r\n\r\nxdel.write(in1);\r\nydel.write(y);\r\n\r\nout1 = y;\r\n"
                                    }
                                },

                                        "outlettype": [ "" ],
                                        "id": "obj-5",
                                        "code": "// ===============================\r\n// EARLY IR – METAL BOX (FIR)\r\n// ===============================\r\n\r\n// delay buffers\r\nDelay d1(5000); Delay d2(5000); Delay d3(5000); Delay d4(5000);\r\nDelay d5(5000); Delay d6(5000); Delay d7(5000); Delay d8(5000);\r\nDelay d9(5000); Delay d10(5000); Delay d11(5000); Delay d12(5000);\r\nDelay d13(5000); Delay d14(5000); Delay d15(5000); Delay d16(5000);\r\nDelay d17(5000); Delay d18(5000); Delay d19(5000); Delay d20(5000);\r\nDelay d21(5000); Delay d22(5000); Delay d23(5000); Delay d24(5000);\r\nDelay d25(5000); Delay d26(5000); Delay d27(5000); Delay d28(5000);\r\nDelay d29(5000); Delay d30(5000); Delay d31(5000); Delay d32(5000);\r\n\r\n// FIR sum\r\ny =\r\n    d1.read(  37) * 0.45 +\r\n    d2.read(  53) * 0.41 +\r\n    d3.read(  71) * 0.38 +\r\n    d4.read(  97) * 0.34 +\r\n    d5.read( 131) * 0.30 +\r\n    d6.read( 173) * 0.27 +\r\n    d7.read( 211) * 0.24 +\r\n    d8.read( 263) * 0.21 +\r\n\r\n    d9.read( 317) * 0.18 +\r\n    d10.read(389) * 0.16 +\r\n    d11.read(457) * 0.14 +\r\n    d12.read(541) * 0.13 +\r\n    d13.read(631) * 0.12 +\r\n    d14.read(733) * 0.11 +\r\n    d15.read(839) * 0.10 +\r\n    d16.read(953) * 0.095 +\r\n\r\n    d17.read(1087) * 0.085 +\r\n    d18.read(1231) * 0.075 +\r\n    d19.read(1387) * 0.065 +\r\n    d20.read(1553) * 0.058 +\r\n    d21.read(1733) * 0.052 +\r\n    d22.read(1919) * 0.046 +\r\n    d23.read(2117) * 0.040 +\r\n    d24.read(2333) * 0.035 +\r\n\r\n    d25.read(2579) * 0.030 +\r\n    d26.read(2843) * 0.026 +\r\n    d27.read(3137) * 0.022 +\r\n    d28.read(3461) * 0.018 +\r\n    d29.read(3817) * 0.015 +\r\n    d30.read(4219) * 0.012 +\r\n    d31.read(4651) * 0.009 +\r\n    d32.read(4999) * 0.006;\r\n\r\n// write input to all taps\r\nd1.write(in1);  d2.write(in1);  d3.write(in1);  d4.write(in1);\r\nd5.write(in1);  d6.write(in1);  d7.write(in1);  d8.write(in1);\r\nd9.write(in1);  d10.write(in1); d11.write(in1); d12.write(in1);\r\nd13.write(in1); d14.write(in1); d15.write(in1); d16.write(in1);\r\nd17.write(in1); d18.write(in1); d19.write(in1); d20.write(in1);\r\nd21.write(in1); d22.write(in1); d23.write(in1); d24.write(in1);\r\nd25.write(in1); d26.write(in1); d27.write(in1); d28.write(in1);\r\nd29.write(in1); d30.write(in1); d31.write(in1); d32.write(in1);\r\n\r\n// output\r\nout1 = y;\r\n"
                                    }

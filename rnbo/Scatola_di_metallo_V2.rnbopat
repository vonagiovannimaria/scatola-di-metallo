                                        "numoutlets": 1,
                                        "fontface": 0,
                                        "outlettype": [ "" ],
                                        "id": "obj-5",
                                        "code": "// APF\r\n\r\nDelay xdel(44100);\r\nDelay ydel(44100);\r\n\r\nParam mult(1.0);\r\n\r\ng      = 0.7;\r\nd_base = 347;\r\noffset = 0;\r\n\r\nds = d_base * mult + offset;\r\nds = max(1, min(4000, ds));\r\n\r\nx_d = xdel.read(ds);\r\ny_d = ydel.read(ds);\r\n\r\ny = (-g * in1) + x_d + (g * y_d);\r\n\r\nxdel.write(in1);\r\nydel.write(y);\r\n\r\nout1 = y;\r\n"

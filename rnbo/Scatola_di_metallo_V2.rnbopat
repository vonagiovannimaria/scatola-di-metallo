                                        "code": "// ===============================\r\n// EARLY IR – PLATE (FIR)\r\n// ===============================\r\n\r\n// delay buffers\r\nDelay d1(8000);  Delay d2(8000);  Delay d3(8000);  Delay d4(8000);\r\nDelay d5(8000);  Delay d6(8000);  Delay d7(8000);  Delay d8(8000);\r\nDelay d9(8000);  Delay d10(8000); Delay d11(8000); Delay d12(8000);\r\nDelay d13(8000); Delay d14(8000); Delay d15(8000); Delay d16(8000);\r\nDelay d17(8000); Delay d18(8000); Delay d19(8000); Delay d20(8000);\r\nDelay d21(8000); Delay d22(8000); Delay d23(8000); Delay d24(8000);\r\nDelay d25(8000); Delay d26(8000); Delay d27(8000); Delay d28(8000);\r\nDelay d29(8000); Delay d30(8000); Delay d31(8000); Delay d32(8000);\r\nDelay d33(8000); Delay d34(8000); Delay d35(8000); Delay d36(8000);\r\nDelay d37(8000); Delay d38(8000); Delay d39(8000); Delay d40(8000);\r\n\r\n// FIR sum (dense + smooth)\r\ny =\r\n    d1.read(  41) * 0.22 +\r\n    d2.read(  59) * 0.22 +\r\n    d3.read(  83) * 0.21 +\r\n    d4.read( 113) * 0.21 +\r\n    d5.read( 149) * 0.20 +\r\n    d6.read( 193) * 0.20 +\r\n    d7.read( 241) * 0.19 +\r\n    d8.read( 307) * 0.19 +\r\n\r\n    d9.read( 367) * 0.18 +\r\n    d10.read(433) * 0.18 +\r\n    d11.read(503) * 0.17 +\r\n    d12.read(587) * 0.17 +\r\n    d13.read(673) * 0.16 +\r\n    d14.read(769) * 0.16 +\r\n    d15.read(877) * 0.15 +\r\n    d16.read(991) * 0.15 +\r\n\r\n    d17.read(1123) * 0.14 +\r\n    d18.read(1277) * 0.14 +\r\n    d19.read(1439) * 0.13 +\r\n    d20.read(1613) * 0.13 +\r\n    d21.read(1801) * 0.12 +\r\n    d22.read(2003) * 0.12 +\r\n    d23.read(2227) * 0.11 +\r\n    d24.read(2467) * 0.11 +\r\n\r\n    d25.read(2729) * 0.10 +\r\n    d26.read(3011) * 0.10 +\r\n    d27.read(3313) * 0.095 +\r\n    d28.read(3643) * 0.090 +\r\n    d29.read(3997) * 0.085 +\r\n    d30.read(4387) * 0.080 +\r\n    d31.read(4817) * 0.075 +\r\n    d32.read(5291) * 0.070 +\r\n\r\n    d33.read(5813) * 0.065 +\r\n    d34.read(6389) * 0.060 +\r\n    d35.re